```{=html}
<div class="recent-list list">
<% for (const item of items) { %>
  <% const title = item["home-title"] || item.title; %>
  <% const description = item["home-description"] || item.description || item.subtitle; %>
  <article class="recent-item" <%= metadataAttrs(item) %>>
    <span class="recent-date listing-date"><%- item.date %></span>
    <h3><a class="listing-title" href="<%- item.path %>"><%- title %></a></h3>
    <% if (description) { %><p class="listing-description"><%- description %></p><% } %>
  </article>
<% } %>
</div>
```
